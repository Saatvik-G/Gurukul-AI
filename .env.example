# ==============================================================================
# Gurukul AI - Environment Variables Example
# Duplicate this file to .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# Google Gemini API Key (Flash 1.5 / Embedding 004)
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Text-to-Speech API Key
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLOUD_TTS_KEY=your_google_cloud_tts_key_here

# Neon PostgreSQL Database Connection (with pgvector)
# Get from Neon Console: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob Storage Token (Optional - for TTS audio caching on Vercel)
# Get from Vercel Project Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token_here
