# ==============================================================================
# Gurukul AI - Environment Variables Example
# Duplicate this file to .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# Google Gemini API Key (Flash 1.5 / Embedding 004)
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Text-to-Speech API Key
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLOUD_TTS_KEY=your_google_cloud_tts_key_here

# Supabase Credentials (PostgreSQL + pgvector)
# Get from Supabase Project Settings -> API: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
